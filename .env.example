# Supabase project settings (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Postgres connection strings (Settings → Database)
# DATABASE_URL: pooled/transaction connection — used by the running app (server/db/client.ts)
# DIRECT_URL: direct connection — used only by `prisma migrate` / `prisma db seed` (prisma.config.ts)
#
# Temporary local-dev fallback: if your Supabase project only exposes one
# connection string right now, set both to the same (direct, non-pooled)
# value. Do NOT do this in production — running migrations against a pooled
# PgBouncer connection can fail or corrupt migration state.
DATABASE_URL=
DIRECT_URL=

# Base URL of this app, used to build the magic-link redirect target.
# Must also be added to Supabase Auth → URL Configuration → Redirect URLs
# as `${NEXT_PUBLIC_SITE_URL}/auth/callback`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kori's Conversation Intelligence Engine — vendor-agnostic AI provider layer
# (server/intelligence/ai-router.ts, provider-registry.ts, provider-factory.ts).
# Unit tests never need any of these — they inject a mocked AIProvider directly.

# Which AI provider to route to. Only this provider's SDK/credentials are ever
# initialized — the other vendor credentials below can be left blank.
# Currently implemented: anthropic. (openai, groq, gemini are not implemented yet.)
AI_PROVIDER=anthropic
# No default model is assumed — set this explicitly to a model id valid for
# the selected AI_PROVIDER at the time you configure this.
AI_MODEL=

# Provider credentials — independent of AI_PROVIDER; only the selected
# provider's key is actually read.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# Gate for real-network integration tests
# (server/intelligence/__tests__/anthropic-ai-provider.integration.test.ts) and for
# server/intelligence/scripts/analyze-samples.ts. Leave false for normal `npm test` runs —
# these tests are skipped by default and never gate the suite.
RUN_REAL_AI_TESTS=false
