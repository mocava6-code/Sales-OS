# Supabase project settings (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Postgres connection strings (Settings → Database)
# DATABASE_URL: pooled/transaction connection — used by the running app (server/db/client.ts)
# DIRECT_URL: direct connection — used only by `prisma migrate` / `prisma db seed` (prisma.config.ts)
#
# Temporary local-dev fallback: if your Supabase project only exposes one
# connection string right now, set both to the same (direct, non-pooled)
# value. Do NOT do this in production — running migrations against a pooled
# PgBouncer connection can fail or corrupt migration state.
DATABASE_URL=
DIRECT_URL=

# Base URL of this app, used to build the magic-link redirect target.
# Must also be added to Supabase Auth → URL Configuration → Redirect URLs
# as `${NEXT_PUBLIC_SITE_URL}/auth/callback`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
