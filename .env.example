# Supabase project settings (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Postgres connection strings (Settings → Database)
# DATABASE_URL: pooled/transaction connection — used by the running app (server/db/client.ts)
# DIRECT_URL: direct connection — used only by `prisma migrate` / `prisma db seed` (prisma.config.ts)
#
# Temporary local-dev fallback: if your Supabase project only exposes one
# connection string right now, set both to the same (direct, non-pooled)
# value. Do NOT do this in production — running migrations against a pooled
# PgBouncer connection can fail or corrupt migration state.
DATABASE_URL=
DIRECT_URL=

# Base URL of this app, used to build the magic-link redirect target.
# Must also be added to Supabase Auth → URL Configuration → Redirect URLs
# as `${NEXT_PUBLIC_SITE_URL}/auth/callback`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kori's Conversation Intelligence Engine — vendor-agnostic AI provider layer
# (server/intelligence/ai-router.ts, provider-registry.ts, provider-factory.ts).
# Unit tests never need any of these — they inject a mocked AIProvider directly.

# Which AI provider to route to. Only this provider's SDK/credentials are ever
# initialized — the other vendor credentials below can be left blank.
# Currently implemented: anthropic. (openai, groq, gemini are not implemented yet.)
AI_PROVIDER=anthropic
# No default model is assumed — set this explicitly to a model id valid for
# the selected AI_PROVIDER at the time you configure this.
AI_MODEL=

# Provider credentials — independent of AI_PROVIDER; only the selected
# provider's key is actually read.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# Kori Natural Language Analytics v0 — question -> KoriQuerySpec parsing
# (server/kori/nl-query-parser.ts, server/kori/groq-client.ts). A small,
# focused Groq adapter — NOT part of the AIProvider router above. Shares
# GROQ_API_KEY with the AI_PROVIDER=groq slot above (same underlying Groq
# account secret; that provider isn't implemented yet, so there's no
# conflict today). Unit tests never need either var — they inject a fake
# GroqClient directly.
# Groq model id used only for Kori's NL parser, e.g. llama-3.3-70b-versatile.
KORI_GROQ_MODEL=
# Set to "json_schema" only if KORI_GROQ_MODEL is known to support Groq's
# strict structured-output mode. Unset (default) uses JSON mode + Zod
# validation (parseKoriQuerySpec), which is the safe default for any model.
KORI_GROQ_STRUCTURED_OUTPUT_MODE=

# Gate for real-network integration tests
# (server/intelligence/__tests__/anthropic-ai-provider.integration.test.ts) and for
# server/intelligence/scripts/analyze-samples.ts. Leave false for normal `npm test` runs —
# these tests are skipped by default and never gate the suite.
RUN_REAL_AI_TESTS=false

# Kori's memory — persistence layer (server/persistence/). Repository tests
# (server/persistence/__tests__) exercise real Prisma/Postgres and must never
# run against this file's DATABASE_URL (the pilot database). Point
# TEST_DATABASE_URL at an isolated local/test Postgres instance instead
# (see .env.test.local, gitignored, for local setup). Leave RUN_DB_TESTS
# false for normal `npm test` runs — these tests are skipped by default and
# never gate the suite.
RUN_DB_TESTS=false
TEST_DATABASE_URL=

# WhatsApp Business Cloud API (server/whatsapp/**) — the webhook at
# app/api/whatsapp/webhook/route.ts and server/whatsapp/sender.ts. Unit
# tests never need any of these — they inject a mocked WhatsAppSenderClient
# and/or fake gateway dependencies directly.

# The secret you choose and enter as the webhook's "Verify token" in the
# Meta App Dashboard. Compared against hub.verify_token on the GET handshake.
WHATSAPP_VERIFY_TOKEN=
# Meta App secret — used to validate the X-Hub-Signature-256 header on every
# webhook POST (server/whatsapp/verification.ts). A webhook payload is never
# processed without this check passing.
WHATSAPP_APP_SECRET=
# System-user access token for the WhatsApp Business Account, used to send
# messages via the Graph API (server/whatsapp/sender.ts). Only read when a
# READY message is actually sent — never at server boot.
WHATSAPP_ACCESS_TOKEN=
# Graph API version, e.g. v21.0. Defaults to v21.0 if unset.
WHATSAPP_API_VERSION=
# Override for the Graph API base URL — only needed to point sender.ts at a
# test double; leave unset in every real environment.
WHATSAPP_GRAPH_API_BASE_URL=
