generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  SALESPERSON
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  WON
  LOST
}

enum LeadPriority {
  NORMAL
  HIGH
}

enum ConversationChannel {
  WHATSAPP
  CALL
  IN_PERSON
  OTHER
}

enum ConversationSource {
  MANUAL_PASTE
  MANUAL_ENTRY
  // WhatsApp Business Integration v1 — populated by the webhook ingestion
  // pipeline (server/whatsapp/gateway.ts), never by a human. Anticipated by
  // name in ARCHITECTURE.md §4/§7 before this phase existed.
  WHATSAPP_SYNCED
  // Historical WhatsApp CRM Import — set only when the import ITSELF
  // creates the conversation (no prior WhatsApp thread existed for the
  // lead). Never retroactively applied to a conversation that already had
  // a source: source stays "how this thread first came to exist," not a
  // live-updated status, even once a conversation has mixed
  // live+backfilled entries (server/services/historical-import-service.ts).
  HISTORICAL_IMPORT
}

enum ConversationStatus {
  NEEDS_REPLY
  WAITING_ON_CUSTOMER
  CLOSED
}

enum EntryDirection {
  INBOUND
  OUTBOUND
}

// The content shape of a ConversationEntry. TEXT covers every non-WhatsApp
// entry (manual paste/entry always produce text) as well as WhatsApp text
// messages; the rest are WhatsApp-specific media/structured message types
// normalized by server/whatsapp/message-normalizer.ts.
enum ConversationEntryMessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  STICKER
  CONTACT
  LOCATION
  UNKNOWN
}

enum FollowUpStatus {
  PENDING
  DONE
  SNOOZED
}

enum KnowledgeCategory {
  PRODUCT
  COMPATIBILITY
  OBJECTION
  COMMERCIAL_POLICY
  PROMOTION
  FAQ
  RECOMMENDED_RESPONSE
  LOGISTICS
  // Knowledge Ingestion v1 — explicit first-class category (not a loose
  // string) so pricing candidates/items are subject to the stricter
  // freshness/no-auto-promotion rules in server/knowledge/**.
  PRICING
}

// Mirrors server/intelligence/decision/types.ts DecisionType exactly — the
// Decision Engine's own vocabulary, not reinvented here.
enum DecisionType {
  RESPOND_TO_CUSTOMER
  ASK_CLARIFYING_QUESTION
  FOLLOW_UP
  ESCALATE_TO_HUMAN
  RECOMMEND_SALES_APPROACH
  WARN_ADVISOR
  ORGANIZE_CONVERSATION
  WAIT
  NO_ACTION
}

enum DecisionRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DecisionImpactLevel {
  LOW
  MEDIUM
  HIGH
}

enum DecisionApprovalRequirement {
  AUTO_ALLOWED
  ADVISOR_APPROVAL_REQUIRED
  ADMIN_APPROVAL_REQUIRED
  HUMAN_INFORMATION_REQUIRED
}

// Fast-query denormalization on DecisionRecord — the DecisionEvent log is
// the source of truth (see § Event history in ARCHITECTURE.md / Phase D report).
//
// OVERRIDDEN is distinct from REJECTED: a rejection means the advisor said
// no and did nothing; an override means the advisor acted, just not on
// Kori's recommendation. Historical REJECTED rows are never reinterpreted
// as OVERRIDDEN — this is a new terminal value, not a rename.
enum DecisionStatus {
  PROPOSED
  APPROVED
  REJECTED
  EXECUTED
  CANCELLED
  OVERRIDDEN
}

// Append-only lifecycle log. Almost a strict superset of DecisionStatus (so
// most status transitions can also be recorded as an event) plus downstream
// commercial-outcome-adjacent events — except OVERRIDDEN, which is
// deliberately never recorded as a bare "OVERRIDDEN" event: recordAdvisorOverride
// always fires the more specific ADVISOR_OVERRIDDEN instead, which already
// carries strictly more information. Never aggregated — see DecisionEvent model.
enum DecisionEventType {
  PROPOSED
  APPROVED
  REJECTED
  EXECUTED
  CANCELLED
  CUSTOMER_REPLIED
  FOLLOW_UP_SENT
  SALE_CLOSED
  SALE_LOST
  ADVISOR_OVERRIDDEN
  KORI_OVERRIDDEN
}

enum AdvisorActionType {
  FOLLOWED_RECOMMENDATION
  IGNORED_RECOMMENDATION
  PARTIALLY_FOLLOWED_RECOMMENDATION
  CUSTOM_ACTION
}

enum OutcomeType {
  CUSTOMER_REPLIED
  MEETING_SCHEDULED
  FOLLOW_UP_SENT
  QUOTATION_REQUESTED
  QUOTATION_SENT
  SALE_CLOSED
  SALE_LOST
  ABANDONED
}

// What actually produced an outcome — required for SALE_CLOSED/SALE_LOST,
// optional elsewhere. Never inferred; always supplied explicitly by the
// caller recording the outcome (see server/orchestration/outcome-attribution-policy.ts).
enum OutcomeAttribution {
  KORI_RECOMMENDATION
  ADVISOR_ALTERNATIVE
  UNATTRIBUTED
}

// ── Models ───────────────────────────────────────────────────────────────

model Business {
  id          String   @id @default(uuid())
  name        String   @unique
  // Logical pointer to the owning User, intentionally not an enforced FK:
  // Business and User each require the other to exist, so a hard relation
  // in both directions would make the very first insert impossible.
  ownerUserId String?
  createdAt   DateTime @default(now())
  // IANA timezone identifier (e.g. "America/Lima") — Sprint 7's Lead
  // Commercial State relative-date extractor resolves expressions like
  // "mañana a las 12" in this timezone before converting to UTC for
  // storage. Defaulted so every existing row stays valid without a backfill.
  timezone    String   @default("America/Lima")

  users                    User[]
  leads                    Lead[]
  conversations            Conversation[]
  knowledgeItems           KnowledgeItem[]
  dailyInsights            DailyInsight[]
  conversationSnapshots    ConversationSnapshot[]
  decisionRecords          DecisionRecord[]
  conversationAnalysisRuns ConversationAnalysisRun[]
  whatsappPhoneNumbers     WhatsAppPhoneNumber[]
  pendingWhatsAppMessages  PendingWhatsAppMessage[]
  domainEvents             DomainEvent[]
  observations             Observation[]

  // Knowledge Ingestion v1
  knowledgeSources                KnowledgeSource[]
  importedConversations           ImportedConversation[]
  websitePages                    WebsitePage[]
  knowledgeCandidates             KnowledgeCandidate[]
  knowledgeCandidateRelationships KnowledgeCandidateRelationship[]
  operationalInsights             OperationalInsight[]

  @@map("businesses")
}

model User {
  id         String   @id @default(uuid())
  // Nullable, set exactly once on first successful login. Never used to look
  // up a user — that's authUserId's job once it's populated.
  authUserId String?  @unique
  // Always stored normalized (trim + lowercase). The only field used to
  // match a freshly authenticated Supabase user to a seeded record.
  email      String   @unique
  name       String
  role       UserRole
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  createdAt  DateTime @default(now())

  assignedLeads          Lead[]                   @relation("LeadAssignee")
  followUps              FollowUp[]
  conversationsCreated   Conversation[]           @relation("ConversationCreatedBy")
  knowledgeItemsCreated  KnowledgeItem[]          @relation("KnowledgeItemCreatedBy")
  dailyInsights          DailyInsight[]
  advisorActions         AdvisorAction[]
  queuedWhatsAppMessages PendingWhatsAppMessage[]

  // Knowledge Ingestion v1
  knowledgeSourcesCreated     KnowledgeSource[]
  knowledgeItemsApproved      KnowledgeItem[]      @relation("KnowledgeItemApprovedBy")
  operationalInsightsApproved OperationalInsight[] @relation("OperationalInsightApprovedBy")

  @@map("users")
}

model Lead {
  id               String       @id @default(uuid())
  businessId       String
  business         Business     @relation(fields: [businessId], references: [id])
  name             String
  phone            String
  status           LeadStatus   @default(NEW)
  priority         LeadPriority @default(NORMAL)
  assignedToUserId String?
  assignedTo       User?        @relation("LeadAssignee", fields: [assignedToUserId], references: [id])
  lastContactAt    DateTime?
  createdAt        DateTime     @default(now())

  conversations Conversation[]
  followUps     FollowUp[]

  @@index([businessId])
  @@map("leads")
}

model Conversation {
  id                    String               @id @default(uuid())
  businessId            String
  business              Business             @relation(fields: [businessId], references: [id])
  leadId                String
  lead                  Lead                 @relation(fields: [leadId], references: [id])
  channel               ConversationChannel  @default(WHATSAPP)
  source                ConversationSource
  status                ConversationStatus   @default(NEEDS_REPLY)
  lastEntryAt           DateTime
  lastEntryDirection    EntryDirection
  // Populated by a later milestone (AI summarization). Always null for now.
  aiSummary             String?
  // Nullable since WhatsApp Business Integration v1: a conversation created
  // by an inbound webhook has no human creator. Manual-entry conversations
  // (source = MANUAL_PASTE/MANUAL_ENTRY) always still set this.
  createdByUserId       String?
  createdBy             User?                @relation("ConversationCreatedBy", fields: [createdByUserId], references: [id])
  // Which of the business's WhatsApp numbers this thread belongs to — set
  // once at creation from the inbound webhook's resolved number, reused for
  // every outbound reply in the thread. Null for non-WhatsApp conversations.
  whatsappPhoneNumberId String?
  whatsappPhoneNumber   WhatsAppPhoneNumber? @relation(fields: [whatsappPhoneNumberId], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  entries                 ConversationEntry[]
  insightEvidence         InsightEvidence[]
  snapshots               ConversationSnapshot[]
  decisionRecords         DecisionRecord[]
  analysisRuns            ConversationAnalysisRun[]
  pendingWhatsAppMessages PendingWhatsAppMessage[]
  domainEvents            DomainEvent[]
  observations            Observation[]

  @@index([businessId])
  @@index([leadId])
  @@map("conversations")
}

model ConversationEntry {
  id             String                       @id @default(uuid())
  conversationId String
  conversation   Conversation                 @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      EntryDirection
  // Human-readable summary — the message text itself, or a caption/fallback
  // label for non-text content (e.g. "[image]"). Always populated.
  content        String
  messageType    ConversationEntryMessageType @default(TEXT)
  occurredAt     DateTime
  createdAt      DateTime                     @default(now())

  // WhatsApp Business Integration v1 fields — all null for manually-logged
  // entries. externalId is the idempotency key for inbound webhook
  // processing (server/whatsapp/gateway.ts): a duplicate wamid safely no-ops
  // on the unique constraint instead of creating a second entry.
  externalId       String? @unique
  mediaId          String?
  mediaMimeType    String?
  mediaFilename    String?
  mediaSizeBytes   Int?
  mediaCaption     String?
  // wamid of the message this one replies to/quotes, if any — not a FK
  // (the quoted message may not exist in our DB, e.g. it predates ingestion).
  quotedExternalId String?
  // Raw Meta payload node for this message, preserved verbatim for
  // debugging — never read by any normal application code path.
  rawPayload       Json?

  @@index([conversationId])
  @@map("conversation_entries")
}

model FollowUp {
  id        String         @id @default(uuid())
  leadId    String
  lead      Lead           @relation(fields: [leadId], references: [id])
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  dueAt     DateTime
  status    FollowUpStatus @default(PENDING)
  note      String?
  createdAt DateTime       @default(now())

  @@index([leadId])
  @@index([userId])
  @@map("follow_ups")
}

model KnowledgeItem {
  id              String            @id @default(uuid())
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id])
  title           String
  content         String
  category        KnowledgeCategory
  tags            String[]
  createdByUserId String
  createdBy       User              @relation("KnowledgeItemCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Knowledge Ingestion v1 — every row in this table is created exclusively
  // by an OWNER approving a KnowledgeCandidate (server/knowledge/promotion.ts);
  // there is no auto-promotion path and no manual "Teach Sales OS" form, so
  // approvedByUserId/approvedAt are required, not optional. Confirmed safe as
  // a required-column migration: both the pilot and test databases had zero
  // KnowledgeItem rows at the time this was added (see migration comment).
  status             KnowledgeItemStatus @default(ACTIVE)
  confidence         Float?
  originCandidateId  String?
  approvedByUserId   String
  approvedBy         User                @relation("KnowledgeItemApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt         DateTime
  // Self-relation — the newer, OWNER-approved item that replaced this one.
  // Never hard-deleted; SUPERSEDED items are excluded from any future
  // retrieval use but stay in the audit trail.
  supersededByItemId String?
  // Required at promotion time for PRICING/COMMERCIAL_POLICY/PROMOTION —
  // stricter freshness rule than other categories (Sprint 8 policy).
  expiresAt          DateTime?

  candidateRelationships KnowledgeCandidateRelationship[]

  @@index([businessId])
  @@map("knowledge_items")
}

// Empty/unused this milestone — schema only. No AI generation is implemented
// yet, so no rows are ever created here.
model DailyInsight {
  id              String   @id @default(uuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  insightDate     DateTime
  observation     String
  recommendation  String
  suggestedAction String
  createdAt       DateTime @default(now())

  evidence InsightEvidence[]

  @@index([businessId, userId, insightDate])
  @@map("daily_insights")
}

model InsightEvidence {
  id             String       @id @default(uuid())
  dailyInsightId String
  dailyInsight   DailyInsight @relation(fields: [dailyInsightId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  excerpt        String?
  createdAt      DateTime     @default(now())

  @@map("insight_evidence")
}

// ── Kori's memory (Phase D) ─────────────────────────────────────────────
//
// Persists Decision Engine input/output history so a future Learning Engine
// can be built entirely from stored evidence. Every model here is
// append-only in practice: only DecisionRecord.status is ever updated after
// creation (a denormalized fast-query field — see DecisionEvent), nothing
// else in this section is ever mutated or deleted by application code.

// One row per Conversation Intelligence Engine run (server/intelligence/
// analyze-conversation.ts). Verbatim persistence of ConversationIntelligenceResult
// (server/intelligence/types.ts) — never edited after creation; re-analyzing
// a conversation creates a new row, not an update, so the history of what
// Kori knew *at each point in time* is fully reconstructable.
model ConversationSnapshot {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  // ConversationIntelligenceResult, split field-by-field rather than stored
  // as one blob so each concern (verified vs. inferred vs. unknown) stays
  // independently queryable — mirrors the type-level separation already
  // enforced in server/intelligence/types.ts.
  customerIdentification Json
  facts                  Json
  inferences             Json
  objections             Json
  missingInformation     Json
  warnings               Json
  draftResponse          Json?
  overallConfidence      Float

  // Versioning (EngineRunMetadata) — never overwritten; reproduces exactly
  // which engine schema / prompt / model produced this snapshot.
  engineSchemaVersion Int
  promptVersion       String
  aiProvider          String
  modelName           String
  analyzedAt          DateTime

  createdAt DateTime @default(now())

  decisionRecords DecisionRecord[]

  @@index([conversationId, createdAt])
  @@index([businessId])
  @@map("conversation_snapshots")
}

// One row per KoriDecision (server/intelligence/decision/types.ts) ever
// proposed. Everything except `status` is immutable after creation — a
// decision is never edited, only ever superseded by a new proposal or
// followed by DecisionEvent/AdvisorAction/Outcome rows.
model DecisionRecord {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  // Context reference — which conversation this decision was about, and
  // (when the engine ran on a persisted snapshot) exactly which
  // ConversationSnapshot informed it.
  conversationId         String
  conversation           Conversation          @relation(fields: [conversationId], references: [id])
  conversationSnapshotId String?
  conversationSnapshot   ConversationSnapshot? @relation(fields: [conversationSnapshotId], references: [id])

  // The Decision Engine's own deterministic id (makeDecisionId in
  // server/intelligence/decision/types.ts) — kept for correlation with
  // engine output/logs. Not this table's primary key: the engine's id is a
  // pure function of (conversationId, type, index), so re-running the
  // engine on the same conversation can legitimately repeat it, and every
  // run must still persist as its own historical row.
  engineDecisionId String

  type                DecisionType
  title               String
  recommendation      String
  objective           String
  reasoning           String
  evidence            Json
  assumptions         String[]
  missingInformation  Json
  alternatives        Json
  confidence          Float
  riskLevel           DecisionRiskLevel
  impactLevel         DecisionImpactLevel
  approvalRequirement DecisionApprovalRequirement
  suggestedAction     Json
  customerProfile     Json?
  warnings            Json

  // Fast-query denormalization of current status. DecisionEvent is the
  // source of truth for the full history of how it got here.
  status DecisionStatus @default(PROPOSED)

  // Versioning (KoriDecisionMetadata) — never overwritten.
  engineSchemaVersion                       Int
  promptVersion                             String
  aiProvider                                String
  modelName                                 String
  decidedAt                                 DateTime
  sourceConversationIntelligenceGeneratedAt DateTime?

  createdAt DateTime @default(now())

  events                  DecisionEvent[]
  advisorActions          AdvisorAction[]
  outcomes                Outcome[]
  pendingWhatsAppMessages PendingWhatsAppMessage[]

  @@index([conversationId])
  @@index([businessId])
  @@index([status])
  @@index([conversationSnapshotId])
  @@map("decision_records")
}

// Append-only chronological log of every status transition and downstream
// commercial event for a decision. Never aggregated or summarized in place —
// a future Learning Engine reconstructs history by replaying these rows.
model DecisionEvent {
  id               String            @id @default(uuid())
  decisionRecordId String
  decisionRecord   DecisionRecord    @relation(fields: [decisionRecordId], references: [id])
  eventType        DecisionEventType
  note             String?
  occurredAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())

  @@index([decisionRecordId, occurredAt])
  @@map("decision_events")
}

// What the human advisor actually did in response to a decision. Append-only
// — a decision can accumulate more than one AdvisorAction over time (e.g.
// "partially followed" now, "custom action" logged later).
model AdvisorAction {
  id               String            @id @default(uuid())
  decisionRecordId String
  decisionRecord   DecisionRecord    @relation(fields: [decisionRecordId], references: [id])
  actionType       AdvisorActionType
  advisorUserId    String?
  advisor          User?             @relation(fields: [advisorUserId], references: [id])
  notes            String?
  occurredAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())

  @@index([decisionRecordId])
  @@map("advisor_actions")
}

// The commercial result that followed a decision. Append-only — a single
// decision's thread can accumulate a sequence of outcomes over time
// (customer replied, then a quotation was sent, then the sale closed).
model Outcome {
  id               String              @id @default(uuid())
  decisionRecordId String
  decisionRecord   DecisionRecord      @relation(fields: [decisionRecordId], references: [id])
  outcomeType      OutcomeType
  // Required for SALE_CLOSED/SALE_LOST, optional otherwise — enforced at the
  // orchestration boundary (server/orchestration/outcome-attribution-policy.ts),
  // not by a DB constraint, since the requirement is conditional on outcomeType.
  attribution      OutcomeAttribution?
  notes            String?
  occurredAt       DateTime            @default(now())
  createdAt        DateTime            @default(now())

  @@index([decisionRecordId])
  @@map("outcomes")
}

// Idempotency guard for analyzeConversationAndCreateDecisions (Kori
// Application Integration v1) — its mere existence means "a run is
// currently in progress for this conversation." Created before the AI
// calls, deleted in a finally block after (see
// server/application/analysis-run-lock.ts). No status/history value here —
// this is disposable coordination state, not commercial memory.
model ConversationAnalysisRun {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  startedAt      DateTime     @default(now())

  @@unique([conversationId])
  @@map("conversation_analysis_runs")
}

// ── WhatsApp Business Integration v1 ────────────────────────────────────
//
// Meta-specific concerns (webhook parsing, signature verification, Graph
// API calls) live entirely in server/whatsapp/**, never here — these models
// are the persistence surface that layer writes to via server/whatsapp/queue.ts
// and server/services/conversation-service.ts. Kori (server/intelligence,
// server/orchestration) never references any of this.

// A WhatsApp Business Cloud API phone number registered to a business.
// One Meta app/webhook can receive events for many numbers across many
// businesses — phoneNumberId (from the webhook payload's metadata object)
// is how an inbound event resolves back to a business.
model WhatsAppPhoneNumber {
  id                 String   @id @default(uuid())
  businessId         String
  business           Business @relation(fields: [businessId], references: [id])
  // Meta's phone_number_id — the actual routing key for both inbound
  // (webhook metadata.phone_number_id) and outbound (Graph API URL segment).
  phoneNumberId      String   @unique
  displayPhoneNumber String
  // WhatsApp Business Account id this number belongs to (Meta's waba_id).
  wabaId             String
  label              String?
  createdAt          DateTime @default(now())

  pendingMessages PendingWhatsAppMessage[]
  conversations   Conversation[]

  @@index([businessId])
  @@map("whatsapp_phone_numbers")
}

enum PendingWhatsAppMessageStatus {
  READY
  WAITING_APPROVAL
  SENT
  FAILED
  CANCELLED
}

// Kori never sends WhatsApp messages — it only generates recommendations
// (DecisionRecord). A PendingWhatsAppMessage is the actual message content
// an advisor has queued, optionally traced back to the decision that
// suggested it. server/whatsapp/sender.ts consumes READY rows only; nothing
// in this phase moves a row to READY/SENT except an explicit server action
// or sender call — no background worker, no automatic sending.
model PendingWhatsAppMessage {
  id                    String                       @id @default(uuid())
  businessId            String
  business              Business                     @relation(fields: [businessId], references: [id])
  conversationId        String
  conversation          Conversation                 @relation(fields: [conversationId], references: [id])
  whatsappPhoneNumberId String
  whatsappPhoneNumber   WhatsAppPhoneNumber          @relation(fields: [whatsappPhoneNumberId], references: [id])
  toPhoneNumber         String
  body                  String
  status                PendingWhatsAppMessageStatus @default(WAITING_APPROVAL)
  // Optional — set when this reply originated from a Kori recommendation
  // the advisor approved, rather than a fully manual reply.
  decisionRecordId      String?
  decisionRecord        DecisionRecord?              @relation(fields: [decisionRecordId], references: [id])
  createdByUserId       String?
  createdBy             User?                        @relation(fields: [createdByUserId], references: [id])
  // Meta's wamid, set once the sender successfully calls the Graph API.
  externalId            String?                      @unique
  failureReason         String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  sentAt                DateTime?

  statusEvents WhatsAppMessageStatusEvent[]

  @@index([businessId])
  @@index([conversationId])
  @@index([status])
  @@map("pending_whatsapp_messages")
}

enum WhatsAppMessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

// ── Observer Mode v1 ────────────────────────────────────────────────────
//
// Kori's second lens on a conversation, independent of the AI-driven
// Conversation Intelligence / Decision Engine pipeline (§11-§15 above).
// Every inbound/outbound WhatsApp message becomes an immutable DomainEvent;
// the deterministic Observation Engine (server/intelligence/observation/)
// consumes those events and tags typed commercial signals. Read-only —
// nothing here decides or sends anything. See ARCHITECTURE.md §19.

enum DomainEventType {
  CONVERSATION_CREATED
  MESSAGE_RECEIVED
  MESSAGE_SENT
  ATTACHMENT_RECEIVED
  CONVERSATION_CLOSED
}

// Immutable, append-only log of everything that happens to a Conversation.
// The Observation Engine consumes these; a future Memory/Learning
// Engine/BI module reads the same log without touching server/whatsapp or
// server/orchestration.
model DomainEvent {
  id                  String          @id @default(uuid())
  businessId          String
  business            Business        @relation(fields: [businessId], references: [id])
  conversationId      String
  conversation        Conversation    @relation(fields: [conversationId], references: [id])
  conversationEntryId String?
  eventType           DomainEventType
  // The full event object (server/domain-events/types.ts DomainEvent),
  // verbatim — reprocessable, never partially reconstructed from columns.
  payload             Json
  occurredAt          DateTime
  createdAt           DateTime        @default(now())

  observations Observation[]

  @@index([conversationId, occurredAt])
  @@index([businessId])
  @@index([eventType])
  @@map("domain_events")
}

enum ObservationType {
  PRICE_REQUEST
  COMPATIBILITY_QUESTION
  INSTALLATION_QUESTION
  CUSTOMER_GHOSTED
  PHOTO_REQUEST
  DISCOUNT_NEGOTIATION
}

// Read-only signal derived from a DomainEvent by the Observation Engine.
// Never updated or deleted — a future Learning Engine reconstructs
// commercial patterns by reading this table, not by re-deriving it.
model Observation {
  id                  String          @id @default(uuid())
  businessId          String
  business            Business        @relation(fields: [businessId], references: [id])
  conversationId      String
  conversation        Conversation    @relation(fields: [conversationId], references: [id])
  domainEventId       String
  domainEvent         DomainEvent     @relation(fields: [domainEventId], references: [id])
  conversationEntryId String?
  type                ObservationType
  summary             String
  // Evidence[] (server/intelligence/types.ts) — reused, not reinvented.
  evidence            Json
  occurredAt          DateTime
  createdAt           DateTime        @default(now())

  @@index([conversationId, occurredAt])
  @@index([businessId])
  @@index([type])
  @@map("observations")
}

// Chronological delivery-status history for a sent message (Meta's status
// webhooks: sent -> delivered -> read, or failed). One row per distinct
// status per message — a re-delivered identical status webhook safely no-ops
// on the unique constraint rather than duplicating history.
model WhatsAppMessageStatusEvent {
  id               String                 @id @default(uuid())
  pendingMessageId String
  pendingMessage   PendingWhatsAppMessage @relation(fields: [pendingMessageId], references: [id])
  status           WhatsAppMessageStatus
  occurredAt       DateTime
  errorCode        String?
  errorMessage     String?
  rawPayload       Json?
  createdAt        DateTime               @default(now())

  @@unique([pendingMessageId, status])
  @@index([pendingMessageId])
  @@map("whatsapp_message_status_events")
}

// ── Knowledge Ingestion v1 (Sprint 8) ───────────────────────────────────
//
// Knowledge is acquired automatically from existing operational sources
// (the Koriaki website, historical/live WhatsApp conversations) — never
// through a manual "Teach Sales OS" form. Every source converges on the
// same candidate pipeline (server/knowledge/**): Source -> extracted
// candidate -> normalization -> duplicate/conflict detection -> Knowledge
// Base. No candidate is ever auto-promoted into organizational truth in v1
// — KnowledgeItem/OperationalInsight rows only exist because an OWNER
// explicitly approved a KnowledgeCandidate.

enum KnowledgeSourceType {
  WEBSITE
  WHATSAPP_IMPORT
}

enum KnowledgeSourceStatus {
  PENDING
  PROCESSING
  COMPLETED
  // Some units (pages/messages) failed while others succeeded — distinct
  // from FAILED, which means the run produced nothing usable.
  PARTIAL
  FAILED
}

enum ExternalConversationSource {
  WHATSAPP_TXT_EXPORT
  WHATSAPP_ZIP_EXPORT
  PASTED_TEXT
}

// Tracks whether an LLM semantic pass is worth running over this item,
// independent of whether AI is currently configured (Sprint 8 zero-cost
// mode) and independent of whether the deterministic layer already
// produced KnowledgeCandidate rows for it — an item can have deterministic
// candidates AND still be PENDING (deterministic rules are narrow; there
// can be more in the same content than they catch). NOT_EVALUATED is the
// creation-time default and is never treated as a terminal outcome — the
// deterministic pass must resolve every item to NOT_NEEDED or PENDING;
// COMPLETED is set only after an actual LLM pass has run.
enum SemanticAnalysisStatus {
  NOT_EVALUATED
  NOT_NEEDED
  PENDING
  COMPLETED
}

// WhatsApp export date order is import-level configuration, never inferred
// independently per message — see ImportedConversation.dateOrder.
enum ImportDateOrder {
  DMY
  MDY
}

enum ImportedMessageRole {
  BUSINESS
  CUSTOMER
  UNKNOWN
}

enum ImportedConversationResolutionMethod {
  DETERMINISTIC_USER_MATCH
  MANUAL_PROMPT
  UNRESOLVED
}

// Per-page work-item state for the bounded incremental crawl batch runner
// (server/knowledge/website/sync-runner.ts). A future real queue/worker can
// replace whatever drives "process the next batch of DISCOVERED pages"
// without changing this column or any KnowledgeSource/candidate contract.
enum WebsitePageStatus {
  DISCOVERED
  FETCHED
  EXTRACTED
  SKIPPED_UNCHANGED
  FAILED
}

// Page-level *dominant* classification (WebsitePage.pageContext) — the
// authoritative classification for extraction purposes is per section/chunk
// (see KnowledgeCandidateEvidence.chunkContext and ExtractionDocumentInput
// in server/knowledge/extraction-input.ts), since a PRODUCT page can embed a
// TESTIMONIAL blockquote that must never inherit PRODUCT-level authority.
enum WebsitePageContext {
  PRODUCT
  SERVICE
  FAQ
  POLICY
  MARKETING
  TESTIMONIAL
  UNKNOWN
}

enum KnowledgeCandidateClass {
  FACTUAL
  BEHAVIORAL
}

// Deterministic summary state, derived from the KnowledgeCandidateRelationship
// log — never written directly by the LLM. APPROVED/REJECTED are terminal
// and are reached only by an explicit OWNER action (no auto-promotion in v1).
// Once CONFLICT, later EQUIVALENT evidence appends/reinforces occurrenceCount
// but never silently reverts status back to REINFORCED — see
// server/knowledge/candidate-status.ts.
enum KnowledgeCandidateStatus {
  NEW
  REINFORCED
  CONFLICT
  APPROVED
  REJECTED
}

// Output of the grounded LLM relationship-classification step
// (server/knowledge/relationship-classifier.ts) — advisory only. The
// classification never directly writes KnowledgeCandidate.status, promotes,
// supersedes, or deletes anything; a deterministic function does.
enum RelationshipClassification {
  EQUIVALENT
  CONTRADICTORY
  RELATED
  UNRELATED
}

enum EvidenceRefType {
  IMPORTED_MESSAGE
  WEBSITE_PAGE
  // Not populated by anything in this sprint — reserved for when the live
  // WhatsApp pipeline (messages / smb_message_echoes / coexistence history
  // sync) feeds this same extraction pipeline via ConversationEntry.
  CONVERSATION_ENTRY
}

enum BehaviorCategory {
  PROCESS_PATTERN
  SALES_BEHAVIOR
  CUSTOMER_PATTERN
}

enum KnowledgeItemStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

// One row per ingestion run: a single WhatsApp conversation import, or one
// website crawl. Shared parent so app/(app)/knowledge/sources can list both
// kinds from a single query, and so KnowledgeCandidate/KnowledgeCandidateEvidence
// have one real FK to point provenance at regardless of source kind.
model KnowledgeSource {
  id         String                @id @default(uuid())
  businessId String
  business   Business              @relation(fields: [businessId], references: [id])
  sourceType KnowledgeSourceType
  label      String
  status     KnowledgeSourceStatus @default(PENDING)

  // Source-agnostic progress counters for the pollable Sync
  // started->PROCESSING->progress->COMPLETED/PARTIAL/FAILED UI. Both the v1
  // in-process bounded-batch runner and any future real queue/worker write
  // the same three fields — no contract change either way.
  progressTotal     Int?
  progressCompleted Int?
  progressFailed    Int?

  lastSyncedAt   DateTime? // website only
  // {messagesAnalyzed, candidatesFound, reinforced, conflicts} — feeds the
  // Knowledge UI's post-analyze summary line verbatim.
  lastRunSummary Json?
  errorMessage   String?
  // Soft-delete — forward-compat for a future deletion UI/retention policy
  // (see ImportedMessage's doc comment). Not acted on by any code in v1.
  deletedAt      DateTime?

  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  importedConversations ImportedConversation[]
  websitePages          WebsitePage[]
  originatedCandidates  KnowledgeCandidate[]         @relation("OriginatedCandidates")
  evidence              KnowledgeCandidateEvidence[]

  @@index([businessId])
  @@map("knowledge_sources")
}

model ImportedConversation {
  id         String          @id @default(uuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id])
  sourceId   String
  source     KnowledgeSource @relation(fields: [sourceId], references: [id])

  externalSource       ExternalConversationSource
  // The raw export's own chat identifier/filename — distinct from `id`,
  // which is ours. Kept for cross-referencing a re-import against the source.
  sourceConversationId String
  participantLabels    String[]

  // Decision (Sprint 8 review): date order and timezone are import-level
  // configuration, defaulted for the Koriaki/Peru pilot, never inferred
  // independently per message.
  dateOrder ImportDateOrder @default(DMY)
  timezone  String          @default("America/Lima")

  // Participant-role resolution metadata (not manual knowledge entry) — see
  // ImportedMessage.resolvedRole. Deterministic identity match is attempted
  // first; DETERMINISTIC_USER_MATCH/MANUAL_PROMPT/UNRESOLVED records which
  // path was taken so a re-analysis doesn't need to re-ask the question.
  resolvedBusinessSenderLabel String?
  resolutionMethod            ImportedConversationResolutionMethod?

  // sha256 of the uploaded file's bytes — dedupes re-uploads of the same
  // export (a duplicate hash short-circuits to "already imported").
  rawFileHash   String?
  // Ambiguous senders/unparseable timestamps encountered during parsing —
  // never silently dropped, always surfaced here.
  parseWarnings Json?
  importedAt    DateTime @default(now())

  // Zero-cost mode (Sprint 8 review) — set by the deterministic extraction
  // pass to NOT_NEEDED or PENDING regardless of AI availability; only ever
  // moves to COMPLETED after a real LLM pass. Tracked at conversation
  // granularity, matching the extraction call-site granularity (one
  // extraction pass per conversation, not per message).
  semanticAnalysisStatus SemanticAnalysisStatus @default(NOT_EVALUATED)

  messages ImportedMessage[]

  @@index([businessId])
  @@index([sourceId])
  @@map("imported_conversations")
}

model ImportedMessage {
  id                     String               @id @default(uuid())
  importedConversationId String
  importedConversation   ImportedConversation @relation(fields: [importedConversationId], references: [id], onDelete: Cascade)

  senderLabel   String?
  resolvedRole  ImportedMessageRole @default(UNKNOWN)
  // Null — never a guessed date — when the source line's timestamp doesn't
  // parse cleanly under the conversation's configured dateOrder/timezone.
  occurredAt    DateTime?
  // v1 retains this with no automatic purge, so re-extraction on a newer
  // extractor version doesn't require the original file. This is NOT a
  // permanent-retention guarantee: actual retention is governed by a future
  // business data-retention policy. onDelete: Cascade from
  // ImportedConversation already makes deletion structurally possible
  // whenever that policy is defined, without a schema change.
  content       String
  // Original export line(s) this message was parsed from — provenance/audit,
  // not read by normal application code.
  rawLine       String
  // Preserves original order when occurredAt is null/ambiguous.
  sequenceIndex Int

  @@index([importedConversationId])
  @@map("imported_messages")
}

model WebsitePage {
  id         String          @id @default(uuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id])
  sourceId   String
  source     KnowledgeSource @relation(fields: [sourceId], references: [id])

  url           String
  canonicalUrl  String?
  title         String?
  extractedText String?
  // sha256(extractedText) — change detection; unchanged pages skip
  // re-extraction entirely on repeat syncs.
  contentHash   String?
  // Page-wide dominant classification only — see the enum doc comment for
  // why per-chunk context (ExtractionDocumentInput, KnowledgeCandidateEvidence.chunkContext)
  // is the one that actually gates extraction authority.
  pageContext   WebsitePageContext @default(UNKNOWN)
  // Per-page queue state driving the bounded incremental batch runner.
  status        WebsitePageStatus  @default(DISCOVERED)
  httpStatus    Int?

  // Zero-cost mode (Sprint 8 review) — independent of `status`: a page can
  // be status=EXTRACTED (ingestion fully succeeded) while
  // semanticAnalysisStatus stays PENDING forever until AI is configured and
  // a real LLM pass runs. Never set based on AI availability alone.
  semanticAnalysisStatus SemanticAnalysisStatus @default(NOT_EVALUATED)

  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  lastChangedAt DateTime?

  @@unique([sourceId, url])
  @@index([businessId])
  @@index([sourceId, status])
  @@map("website_pages")
}

// A reusable-knowledge proposal awaiting review. Never organizational truth
// on its own — only an OWNER-approved promotion (promoted*Id set) makes it
// one. `class` routes promotion to two disjoint destination tables so
// factual product knowledge and behavioral/process insights are never
// mixed (Sprint 8 Phase 7).
model KnowledgeCandidate {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  class                    KnowledgeCandidateClass
  // Exactly one of these two is set, matching `class` — enforced in
  // application code (server/knowledge/candidate-schema.ts), not a DB
  // constraint, since a candidate is provisional by definition.
  proposedFactualCategory  KnowledgeCategory?
  proposedBehaviorCategory BehaviorCategory?

  subject   String
  statement String

  // The source where this candidate was FIRST extracted. Reinforcement from
  // other sources is captured as additional KnowledgeCandidateEvidence rows,
  // never by changing this field — one candidate can accumulate evidence
  // from many KnowledgeSources without an ownership/provenance change.
  originSourceId String
  originSource   KnowledgeSource @relation("OriginatedCandidates", fields: [originSourceId], references: [id])

  confidence Float
  // Derived deterministic summary — see KnowledgeCandidateStatus's doc
  // comment and server/knowledge/candidate-status.ts. Never written by the
  // LLM directly.
  status     KnowledgeCandidateStatus @default(NEW)

  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  occurrenceCount Int      @default(1)

  extractorName    String
  extractorVersion String

  // Populated only by an explicit OWNER action (server/knowledge/promotion.ts)
  // — nothing else in this schema ever writes these five fields.
  promotedKnowledgeItemId      String?
  promotedOperationalInsightId String?
  reviewedByUserId             String?
  reviewedAt                   DateTime?
  rejectionReason              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence      KnowledgeCandidateEvidence[]
  relationships KnowledgeCandidateRelationship[] @relation("CandidateRelationshipsFrom")
  relatedFrom   KnowledgeCandidateRelationship[] @relation("CandidateRelationshipsTo")

  @@index([businessId])
  @@index([businessId, status])
  @@index([originSourceId])
  @@map("knowledge_candidates")
}

// Append-only log of every comparison made against a candidate — a
// candidate can be EQUIVALENT to multiple candidates, CONTRADICTORY to more
// than one approved KnowledgeItem, etc. KnowledgeCandidate.status is derived
// from this log, never from a single stored pair.
model KnowledgeCandidateRelationship {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  candidateId String
  candidate   KnowledgeCandidate @relation("CandidateRelationshipsFrom", fields: [candidateId], references: [id], onDelete: Cascade)

  // Exactly one of the three targets is set — application-enforced, same
  // discipline as KnowledgeCandidate's proposedFactualCategory/proposedBehaviorCategory split.
  targetCandidateId          String?
  targetCandidate            KnowledgeCandidate? @relation("CandidateRelationshipsTo", fields: [targetCandidateId], references: [id])
  targetKnowledgeItemId      String?
  targetKnowledgeItem        KnowledgeItem?      @relation(fields: [targetKnowledgeItemId], references: [id])
  targetOperationalInsightId String?
  targetOperationalInsight   OperationalInsight? @relation(fields: [targetOperationalInsightId], references: [id])

  classification    RelationshipClassification
  confidence        Float?
  classifierName    String?
  classifierVersion String?

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([candidateId])
  @@index([targetCandidateId])
  @@index([targetKnowledgeItemId])
  @@index([targetOperationalInsightId])
  @@map("knowledge_candidate_relationships")
}

// One row per occurrence/evidence instance — makes KnowledgeCandidate.occurrenceCount
// real rather than just a counter, and gives every candidate an exact chain
// back to import file / URL / message / timestamp / sender.
model KnowledgeCandidateEvidence {
  id          String             @id @default(uuid())
  candidateId String
  candidate   KnowledgeCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // Direct FK, independent of candidate.originSourceId — this evidence may
  // come from a *different* source than the one that first produced the
  // candidate. Also used for tenant validation without joining through candidate.
  sourceId String
  source   KnowledgeSource @relation(fields: [sourceId], references: [id])

  // Polymorphic — justified, unlike KnowledgeCandidate.originSourceId: no
  // common table exists across the three possible origins.
  evidenceRefType EvidenceRefType
  evidenceRefId   String
  // The minimum relevant grounded excerpt only — never the full source
  // message/page, and never a copy of an entire conversation.
  evidenceText    String

  // Set only when evidenceRefType = WEBSITE_PAGE — the section/chunk-level
  // authority classification in effect when THIS evidence was extracted,
  // independent of WebsitePage.pageContext's page-wide dominant label (a
  // TESTIMONIAL chunk on an otherwise PRODUCT page is recorded as
  // TESTIMONIAL here, never silently inherited as PRODUCT).
  chunkContext WebsitePageContext?

  occurredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([candidateId])
  @@index([sourceId])
  @@map("knowledge_candidate_evidence")
}

// Kept structurally separate from KnowledgeItem (never the same table, never
// the same promotion target) — factual product knowledge and behavioral/
// process insights must not mix (Sprint 8 Phase 7).
model OperationalInsight {
  id         String              @id @default(uuid())
  businessId String
  business   Business            @relation(fields: [businessId], references: [id])
  category   BehaviorCategory
  statement  String
  confidence Float
  status     KnowledgeItemStatus @default(ACTIVE)

  originCandidateId String?
  occurrenceCount   Int      @default(1)
  firstObservedAt   DateTime
  lastObservedAt    DateTime

  // Required — no path creates this row without an explicit OWNER approval.
  approvedByUserId String
  approvedBy       User     @relation("OperationalInsightApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateRelationships KnowledgeCandidateRelationship[]

  @@index([businessId])
  @@map("operational_insights")
}
